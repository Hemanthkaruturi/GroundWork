{
  "hooks": {
    "SessionStart": [
      { "matcher": "startup|resume|clear|compact",
        "hooks": [{ "type": "command", "command": "PY=$(command -v python3 || command -v python) && \"$PY\" \"${CLAUDE_PLUGIN_ROOT}/engine/groundwork.py\" session-context" }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "PY=$(command -v python3 || command -v python) && \"$PY\" \"${CLAUDE_PLUGIN_ROOT}/engine/groundwork.py\" prompt-reminder" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "PY=$(command -v python3 || command -v python) && \"$PY\" \"${CLAUDE_PLUGIN_ROOT}/engine/groundwork.py\" stop-brevity" }] }
    ],
    "PreToolUse": [
      { "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "PY=$(command -v python3 || command -v python) && \"$PY\" \"${CLAUDE_PLUGIN_ROOT}/engine/groundwork.py\" gate" }] },
      { "matcher": "Skill",
        "hooks": [{ "type": "command", "command": "PY=$(command -v python3 || command -v python) && \"$PY\" \"${CLAUDE_PLUGIN_ROOT}/engine/groundwork.py\" skill-notice" }] },
      { "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "PY=$(command -v python3 || command -v python) && \"$PY\" \"${CLAUDE_PLUGIN_ROOT}/engine/groundwork.py\" gate-bash" }] }
    ]
  }
}
