{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/engine/groundwork.py\" session-context || python \"${CLAUDE_PLUGIN_ROOT}/engine/groundwork.py\" session-context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/engine/groundwork.py\" prompt-reminder || python \"${CLAUDE_PLUGIN_ROOT}/engine/groundwork.py\" prompt-reminder"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/engine/groundwork.py\" stop-brevity || python \"${CLAUDE_PLUGIN_ROOT}/engine/groundwork.py\" stop-brevity"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Write|Edit|MultiEdit|NotebookEdit|write|edit|apply_patch|notebook_edit)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/engine/groundwork.py\" gate || python \"${CLAUDE_PLUGIN_ROOT}/engine/groundwork.py\" gate"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/engine/groundwork.py\" skill-notice || python \"${CLAUDE_PLUGIN_ROOT}/engine/groundwork.py\" skill-notice"
          }
        ]
      },
      {
        "matcher": "^(Bash|exec)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/engine/groundwork.py\" gate-bash || python \"${CLAUDE_PLUGIN_ROOT}/engine/groundwork.py\" gate-bash"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^skill$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/engine/groundwork.py\" skill-notice || python \"${CLAUDE_PLUGIN_ROOT}/engine/groundwork.py\" skill-notice"
          }
        ]
      }
    ]
  }
}
